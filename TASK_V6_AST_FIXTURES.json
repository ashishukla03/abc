              "path": "plots.plot3"
            },
            "right": {
              "nodeType": "literal",
              "valueType": "number",
              "value": 6
            }
          },
          {
            "nodeType": "comparison",
            "operator": "EQ",
            "left": {
              "nodeType": "variable",
              "path": "water.allocated"
            },
            "right": {
              "nodeType": "literal",
              "valueType": "number",
              "value": 12
            }
          }
        ]
      },
      "expectedResult": true
    },
    {
      "id": "valid_between_and_not",
      "description": "Valid BETWEEN operator with NOT condition",
      "state": {
        "solution.ph": 7.0,
        "gate.open": false
      },
      "ast": {
        "nodeType": "logical",
        "operator": "AND",
        "children": [
