  "validTestCases": [
    {
      "id": "valid_comparison_simple",
      "description": "Valid scalar comparison checking plot1 == 2",
      "state": {
        "plots.plot1": 2
      },
      "ast": {
        "nodeType": "comparison",
        "operator": "EQ",
        "left": {
          "nodeType": "variable",
          "path": "plots.plot1"
        },
        "right": {
          "nodeType": "literal",
          "valueType": "number",
          "value": 2
        }
      },
      "expectedResult": true
    },
    {
      "id": "valid_nested_logical",
      "description": "Valid nested AND expression for canal water sharing",
      "state": {
        "plots.plot1": 2,
        "plots.plot2": 4,
        "plots.plot3": 6,
        "water.allocated": 12
      },
      "ast": {
        "nodeType": "logical",
        "operator": "AND",
