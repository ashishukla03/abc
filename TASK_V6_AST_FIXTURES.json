                  "nodeType": "variable",
                  "path": "gate.open"
                },
                "right": {
                  "nodeType": "literal",
                  "valueType": "boolean",
                  "value": true
                }
              }
            ]
          }
        ]
      },
      "expectedResult": true
    },
    {
